erations","Decelerations","Accelerations","Accelerations","Uterine activity","Uterine activity","Uterine activity","Signal quality","Elapsed time"],"gcols":["FHR distribution","Baseline","Variability","Decelerations","Accelerations","Uterine activity","Signal quality","Elapsed time"],"pct":{"hist30_std":[6.571,10.286,16.123,22.188],"histcum_mode":[123.5,134.5,145.5,158.5],"histcum_min":[52.5,64.5,84.5,109.5],"win_baseline_bpm":[121.487,131.622,142.858,155.207],"lwin_frac_below_110":[0.0,0.02,0.088,0.217],"cum_time_above_160_min":[0.0,0.162,2.05,12.294],"lwin_baseline_slope":[-0.452,-0.156,0.077,0.383],"win_var_bandwidth":[10.699,16.081,24.551,36.331],"win_stv":[1.857,2.855,4.393,6.148],"lwin_low_var_min_per10":[0.0,0.0,0.739,1.917],"win_dec_n_per10":[0.0,0.0,0.684,1.902],"lwin_dec_n_deep_per10":[0.0,0.0,0.0,0.5],"cum_dec_area":[0.0,0.0,3449.302,10037.26],"trd_min_since_dec":[1.0,4.0,14.0,33.0],"lwin_acc_n_per10":[0.0,0.0,0.223,0.785],"cum_acc_time_sec":[0.0,0.0,58.75,225.75],"win_uc_n_per10":[0.0,1.061,3.2,4.567],"cum_uc_per10":[0.0,1.352,3.167,4.429],"trd_uc_rate_ratio":[0.491,0.983,1.018,1.372],"win_good_frac":[0.6,0.877,0.994,1.0],"elapsed_min":[17.0,32.0,53.0,69.0]},"doc":{"hist30_std":["FHR spread, last 30 min","bpm","How wide the spread of heart rates has been over the last 30 minutes. A wide spread usually means the rate is swinging, most often from repeated decelerations. Not a FIGO concept, but the strongest single feature in this dataset."],"histcum_mode":["Most common FHR so far","bpm","The single heart rate this fetus has spent more of labour at than any other -- its settled resting rate across the whole recording."],"histcum_min":["Lowest FHR so far","bpm","The lowest heart rate reached at any point since the recording began."],"win_baseline_bpm":["Baseline now","bpm","The resting heart rate over the last 30 minutes, with accelerations and decelerations excluded. FIGO normal is 110-160."],"lwin_frac_below_110":["Time below 110 bpm, last 60 min","fraction","The share of the last hour spent below 110 bpm, the bottom of the normal band."],"cum_time_above_160_min":["Total time above 160 bpm","min","Total minutes spent tachycardic since the recording began. Sustained tachycardia can be an early compensation sign."],"lwin_baseline_slope":["Baseline drift, last 60 min","bpm/min","Whether the resting rate is climbing or falling. A slow steady climb is invisible to any fixed threshold but is a recognised warning sign."],"win_var_bandwidth":["Variability, last 30 min","bpm","How much the heart rate wobbles around its own baseline, measured only between events so decelerations cannot inflate it. FIGO calls under 5 reduced and over 25 marked."],"win_stv":["Short-term variability","bpm","Average change between consecutive 3.75-second epochs (the Dawes-Redman measure). Falls before most other signs of distress."],"lwin_low_var_min_per10":["Low-variability minutes per 10 min, last 60","min/10min","How much of the last hour had variability under 5 bpm. A sustained run of flat trace is more concerning than a brief dip."],"win_dec_n_per10":["Decelerations per 10 min, last 30","per 10 min","How often the heart rate is dipping right now."],"lwin_dec_n_deep_per10":["Deep decelerations per 10 min, last 60","per 10 min","Decelerations that drop at least 60 bpm below baseline, which carry more oxygen cost than shallow ones."],"cum_dec_area":["Total deceleration dose so far","bpm.s","Depth multiplied by duration, added up over every deceleration since the recording began -- the accumulated oxygen debt, not just what is happening now."],"trd_min_since_dec":["Minutes since last deceleration","min","How long the trace has been quiet. Large values are reassuring."],"lwin_acc_n_per10":["Accelerations per 10 min, last 60","per 10 min","Accelerations reflect an intact autonomic response and are reassuring."],"cum_acc_time_sec":["Total acceleration time so far","s","Total seconds spent in accelerations since the recording began."],"win_uc_n_per10":["Contractions per 10 min, last 30","per 10 min","Current contraction rate. More than 5 per 10 minutes is tachysystole, which shortens the recovery time between contractions."],"cum_uc_per10":["Contraction rate over the whole labour","per 10 min","Average contraction rate since the recording began."],"trd_uc_rate_ratio":["Contractions now vs this labour average","ratio","Above 1 means contracting faster than this labour has averaged -- labour is intensifying relative to its own norm, not to a textbook."],"win_good_frac":["Signal quality, last 30 min","fraction","The share of the last 30 minutes with usable FHR. Carried as a feature rather than used to exclude records, so poor recording shows up as an explicit contribution instead of silently biasing the score."],"elapsed_min":["Minutes since recording started","min","How long this trace has been running. Time to delivery is NOT available -- the bedside does not know when the baby will be born."]},"prevalence_presets":{"German births 2020\u20132022 (pH < 7.20)":18.1,"German births 2008\u20132010 (pH < 7.20)":13.8,"This research cohort (CTU-CHB)":32.2,"Severe acidaemia (pH < 7.00)":0.26}}